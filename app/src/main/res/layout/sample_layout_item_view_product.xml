<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearViewPager"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@drawable/bg_home_product_card"
    android:elevation="8dp"
    android:padding="10dp">

    <!-- Product Image Slider -->
    <com.denzcoskun.imageslider.ImageSlider
        android:id="@+id/imageslider"
        android:layout_width="0dp"
        android:layout_height="145dp"
        android:background="@drawable/bg_home_product_image"
        android:padding="4dp"
        app:iss_auto_cycle="false"
        app:iss_text_align="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Product Name -->
    <TextView
        android:id="@+id/showProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Product Name"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        app:layout_constraintTop_toBottomOf="@id/imageslider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Product Unit -->
    <TextView
        android:id="@+id/showProductUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="1 Kg"
        android:textColor="#CFCFCF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/showProductName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Price -->
    <TextView
        android:id="@+id/showProductPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:text="₹0"
        android:textColor="@color/green"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/showProductUnit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/showProductAdd"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Add Button -->
    <TextView
        android:id="@+id/showProductAdd"
        android:layout_width="76dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_product_add_button"
        android:gravity="center"
        android:text="Add"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@id/showProductPrice"
        app:layout_constraintBottom_toBottomOf="@id/showProductPrice"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Quantity Counter -->
    <LinearLayout
        android:id="@+id/AddCart"
        android:layout_width="92dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_product_counter"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/showProductPrice"
        app:layout_constraintBottom_toBottomOf="@id/showProductPrice"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/sub"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="-"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/num"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/addnum"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>