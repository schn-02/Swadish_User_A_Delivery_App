<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aboutScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_user_food_dark"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".About.About">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="720dp"
        android:paddingStart="18dp"
        android:paddingTop="26dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/aboutCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="30dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/user_stroke_orange"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_user_about_card_dark"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/foodAnimation"
                    android:layout_width="match_parent"
                    android:layout_height="135dp"
                    android:contentDescription="Food Ordering Animation"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/aboutanimation" />

                <TextView
                    android:id="@+id/aboutTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Swadish"
                    android:textAlignment="center"
                    android:textColor="@color/user_yellow"
                    android:textSize="31sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aboutSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_user_food_chip"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="Food ordering made easy"
                    android:textColor="@color/user_yellow"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="74dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/bg_user_food_divider" />

                <TextView
                    android:id="@+id/aboutDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:lineSpacingExtra="5dp"
                    android:text="Swadish helps users browse food items, add them to cart, place orders, and enjoy a smooth food ordering experience."
                    android:textAlignment="center"
                    android:textColor="@color/user_text_soft"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/featureBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/user_stroke_yellow"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_user_feature_box_dark"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="17dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="17dp">

                        <TextView
                            android:id="@+id/featureTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="What You Can Do"
                            android:textAlignment="center"
                            android:textColor="@color/user_text_white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="42dp"
                            android:layout_height="3dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_user_food_divider" />

                        <TextView
                            android:id="@+id/featuresText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:lineSpacingExtra="8dp"
                            android:text="🍔 Browse tasty food items\n🛒 Add products to cart easily\n💳 Pay online or choose COD\n📦 Track your order history"
                            android:textColor="@color/user_text_soft"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/builtByText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Developed by Sachin Rawat"
                    android:textAlignment="center"
                    android:textColor="@color/user_text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stayInTouch"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_user_contact_chip_dark"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:text="Connect With Us"
                    android:textColor="@color/user_yellow"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/socialContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/instagram"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="18dp"
                        android:background="@drawable/bg_user_social_icon_dark"
                        android:clickable="true"
                        android:contentDescription="Instagram"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/instagram" />

                    <ImageView
                        android:id="@+id/gmail"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="18dp"
                        android:background="@drawable/bg_user_social_icon_dark"
                        android:clickable="true"
                        android:contentDescription="Gmail"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/gmail" />

                    <ImageView
                        android:id="@+id/linkedin"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_user_social_icon_dark"
                        android:clickable="true"
                        android:contentDescription="LinkedIn"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/linkedin" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>