<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearViewPager"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal">

    <!-- Shimmer Card 1 -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/simmer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        app:shimmer_auto_start="true"
        app:shimmer_duration="1200">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_shimmer_product_card"
            android:orientation="vertical"
            android:padding="10dp">

            <View
                android:id="@+id/imagePlaceholder"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:background="@drawable/bg_shimmer_image" />

            <View
                android:id="@+id/titlePlaceholder"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_shimmer_line" />

            <View
                android:id="@+id/unitPlaceholder"
                android:layout_width="55dp"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shimmer_line" />

            <LinearLayout
                android:id="@+id/bottomPlaceholderRow"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/pricePlaceholder"
                    android:layout_width="55dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_shimmer_line" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <View
                    android:id="@+id/buttonPlaceholder"
                    android:layout_width="72dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_shimmer_button" />

            </LinearLayout>

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- Shimmer Card 2 -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/simmer2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        app:shimmer_auto_start="true"
        app:shimmer_duration="1200">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_shimmer_product_card"
            android:orientation="vertical"
            android:padding="10dp">

            <View
                android:id="@+id/imagePlaceholder2"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:background="@drawable/bg_shimmer_image" />

            <View
                android:id="@+id/titlePlaceholder2"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_shimmer_line" />

            <View
                android:id="@+id/unitPlaceholder2"
                android:layout_width="55dp"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shimmer_line" />

            <LinearLayout
                android:id="@+id/bottomPlaceholderRow2"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/pricePlaceholder2"
                    android:layout_width="55dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_shimmer_line" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <View
                    android:id="@+id/buttonPlaceholder2"
                    android:layout_width="72dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_shimmer_button" />

            </LinearLayout>

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

</LinearLayout>